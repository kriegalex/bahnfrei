package web

// checkInPage is the office check-in/call-room workspace (TASK-018, UC-007,
// SYS-025): confirm entries or close check-in in one action, marking every
// still-unconfirmed entry DNS; a DNS entry can be reinstated (referee
// override). TASK-047/SYS-152/UC-041 #4-5: the close action is only offered
// (as a link to its TASK-034-style confirm sub-page, stating the affected
// count) while CloseCount > 0 — nothing still "entered" means nothing for
// it to do, so it is replaced by an explanatory hint rather than a live
// control with no effect. An empty roster explains why (OQ-117: honest for
// both a not-yet-submitted entry list and a roster-managed template meet)
// and links to the capture page, where a roster-seeded meet's participants
// are visible instead.
templ checkInPage(p PageData, v checkInView) {
	@layout(p) {
		<p class="capture-context">{ v.MeetName } — { v.EventLabel }</p>
		<h1 class="capture-title">{ p.T("checkin.title") }</h1>
		<p><a href={ templ.URL("/meets/" + v.MeetID) }>{ p.T("roster.back_to_meet") }</a></p>
		if v.CloseCount > 0 {
			<p><a href={ templ.URL("/meets/" + v.MeetID + "/events/" + v.EventID + "/checkin/close/confirm") } class="button">{ p.T("checkin.close") }</a></p>
		} else if len(v.Rows) > 0 {
			<p class="hint">{ p.T("checkin.close.inapplicable") }</p>
		}
		if len(v.Rows) == 0 {
			<p>{ p.T("checkin.empty") }</p>
			<p><a href={ templ.URL("/meets/" + v.MeetID + "/capture") }>{ p.T("checkin.empty.capture_link") }</a></p>
		} else {
			<div class="table-scroll" tabindex="0">
				<table class="stack-table" role="table">
					<thead role="rowgroup">
						<tr role="row">
							<th scope="col" role="columnheader">{ p.T("roster.name") }</th>
							<th scope="col" role="columnheader">{ p.T("roster.club") }</th>
							<th scope="col" role="columnheader">{ p.T("entries.status") }</th>
							<th scope="col" role="columnheader">{ p.T("checkin.action") }</th>
						</tr>
					</thead>
					<tbody role="rowgroup">
						for _, row := range v.Rows {
							<tr role="row">
								<td role="cell" data-label={ p.T("roster.name") }>{ row.Who }</td>
								<td role="cell" data-label={ p.T("roster.club") }>{ row.ClubName }</td>
								<td role="cell" data-label={ p.T("entries.status") }>{ row.Status }</td>
								<td role="cell" data-label={ p.T("checkin.action") }>
									if row.IsEntered {
										<form action={ templ.URL("/meets/" + v.MeetID + "/entries/" + row.EntryID + "/confirm") } method="post" class="inline-form">
											<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
											<input type="hidden" name="version" value={ row.Version }/>
											<button type="submit">{ p.T("checkin.confirm") }</button>
										</form>
									}
									if row.IsDNS {
										<form action={ templ.URL("/meets/" + v.MeetID + "/entries/" + row.EntryID + "/reinstate") } method="post" class="inline-form">
											<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
											<input type="hidden" name="version" value={ row.Version }/>
											<button type="submit">{ p.T("checkin.reinstate") }</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// seedingPage is the office heat-seeding, lane-draw and round-progression
// workspace (TASK-018, UC-008/009, SYS-026-030): generate/regenerate a
// round's heats, manually override an athlete's heat/lane, and advance the
// round once its results are settled.
templ seedingPage(p PageData, v seedingView) {
	@layout(p) {
		<h1>{ v.MeetName } — { v.EventLabel } — { v.RoundLabel } — { p.T("seeding.title") }</h1>
		<p><a href={ templ.URL("/meets/" + v.MeetID) }>{ p.T("roster.back_to_meet") }</a></p>
		if v.RulesID != "" {
			<p class="hint">{ p.T("seeding.rules_applied") }: { v.RulesID } ({ v.RulesVersion })</p>
		}

		<h2>{ p.T("seeding.generate.title") }</h2>
		<form action={ templ.URL("/meets/" + v.MeetID + "/events/" + v.EventID + "/rounds/" + v.RoundID + "/seeding/generate") } method="post">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<label>{ p.T("seeding.max_heat_size") } <input type="number" name="max_heat_size" min="1" value="8" aria-describedby="seeding-max-heat-size-hint"/></label>
			@helpIcon(p, "seeding.max_heat_size")
			<p class="hint" id="seeding-max-heat-size-hint">{ p.T("seeding.hint.max_heat_size") }</p>
			<label>{ p.T("seeding.track_lanes") } <input type="number" name="track_lanes" min="0" value="8" aria-describedby="seeding-track-lanes-hint"/></label>
			@helpIcon(p, "seeding.track_lanes")
			<p class="hint" id="seeding-track-lanes-hint">{ p.T("seeding.hint.track_lanes") }</p>
			<button type="submit">{ p.T("seeding.generate.submit") }</button>
		</form>

		if v.Tie != nil {
			<h2>{ p.T("seeding.tie.title") }</h2>
			<p>{ p.T("seeding.tie.hint", "mark", v.Tie.Mark, "slots", v.Tie.RemainingSlots) }</p>
			for _, te := range v.Tie.Entries {
				<form action={ templ.URL("/meets/" + v.MeetID + "/events/" + v.EventID + "/rounds/" + v.RoundID + "/manual-advance") } method="post" class="inline-form">
					<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
					<input type="hidden" name="entry_id" value={ te.EntryID }/>
					{ te.Who }
					<select name="code">
						<option value="q">q</option>
						<option value="qD">qD</option>
						<option value="qR">qR</option>
						<option value="qJ">qJ</option>
					</select>
					<button type="submit">{ p.T("seeding.tie.advance") }</button>
				</form>
			}
		}

		if len(v.Units) == 0 {
			<p>{ p.T("seeding.empty") }</p>
		} else {
			for _, u := range v.Units {
				<h2>{ u.Label }</h2>
				<div class="table-scroll">
					<table>
						<thead>
							<tr>
								<th scope="col">{ p.T("roster.name") }</th>
								<th scope="col">{ p.T("roster.club") }</th>
								<th scope="col">{ p.T("entries.seed") }</th>
								<th scope="col">{ p.T("seeding.lane") }</th>
								<th scope="col">{ p.T("seeding.qualification") }</th>
								<th scope="col">{ p.T("seeding.override") }</th>
							</tr>
						</thead>
						<tbody>
							for _, row := range u.Rows {
								<tr>
									<td>{ row.Who }</td>
									<td>{ row.ClubName }</td>
									<td>{ row.SeedMark }</td>
									<td>{ row.Lane }</td>
									<td>
										{ row.Qualification }
										if row.ManualOverride {
											<small>({ p.T("seeding.manual") })</small>
										}
									</td>
									<td>
										<form action={ templ.URL("/meets/" + v.MeetID + "/events/" + v.EventID + "/rounds/" + v.RoundID + "/seeding/override") } method="post" class="inline-form">
											<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
											<input type="hidden" name="entry_id" value={ row.EntryID }/>
											<input type="hidden" name="version" value={ row.Version }/>
											<select name="target_unit">
												for _, opt := range v.UnitOptions {
													<option value={ opt.UnitID } selected?={ opt.UnitID == u.UnitID }>{ opt.Label }</option>
												}
											</select>
											<input type="number" name="lane" min="0" value={ row.Lane }/>
											<button type="submit">{ p.T("seeding.override") }</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		}

		<h2>{ p.T("seeding.advance.title") }</h2>
		<form action={ templ.URL("/meets/" + v.MeetID + "/events/" + v.EventID + "/rounds/" + v.RoundID + "/advance") } method="post">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<label>{ p.T("seeding.advance.top_n") } <input type="number" name="top_n" min="0" placeholder="0"/></label>
			@helpIcon(p, "seeding.advance.top_n")
			<label>{ p.T("seeding.advance.fastest_k") } <input type="number" name="fastest_k" min="0" placeholder="0"/></label>
			@helpIcon(p, "seeding.advance.fastest_k")
			<label>{ p.T("seeding.advance.standard") } <input type="text" name="standard" placeholder="" aria-describedby="seeding-advance-standard-hint"/></label>
			@helpIcon(p, "seeding.advance.standard")
			<p class="hint" id="seeding-advance-standard-hint">{ p.T("seeding.hint.standard") }</p>
			<label>{ p.T("seeding.advance.capacity") } <input type="number" name="finals_capacity" min="0" placeholder="0"/></label>
			@helpIcon(p, "seeding.advance.capacity")
			<label>
				{ p.T("seeding.advance.better_direction") }
				<select name="better_direction">
					<option value="higher">{ p.T("seeding.advance.higher") }</option>
					<option value="lower">{ p.T("seeding.advance.lower") }</option>
				</select>
			</label>
			@helpIcon(p, "seeding.advance.better_direction")
			<button type="submit">{ p.T("seeding.advance.submit") }</button>
		</form>
	}
}
