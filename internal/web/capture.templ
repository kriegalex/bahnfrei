package web

// captureIndexPage lists a meet's capturable units for the field official
// (UC-011/UC-010: track and horizontal field events in the PoC slice).
templ captureIndexPage(p PageData, v captureIndexView) {
	@layout(p) {
		<h1>{ v.MeetName } — { p.T("capture.title") }</h1>
		<p>
			<a href={ templ.URL("/meets/" + v.MeetID) }>{ p.T("roster.back_to_meet") }</a>
			{ " · " }
			<a href={ templ.URL("/meets/" + v.MeetID + "/reconciliation") }>{ p.T("reconciliation.title") }</a>
		</p>
		if len(v.Units) == 0 {
			<p>{ p.T("capture.units_empty") }</p>
		} else {
			<ul>
				for _, u := range v.Units {
					<li>
						<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + u.UnitID) }>{ u.Discipline }</a>
						{ " (" + p.T("family."+u.Family) + ")" }
						{ " · " }
						<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + u.UnitID + "/sheet.pdf") }>{ p.T("pdf.download") }</a>
					</li>
				}
			</ul>
		}
	}
}

// capturePage is the per-unit capture surface (TASK-008): the
// horizontal-attempt grid for field events (SYS-042) or the manual/FAT
// time form for track events (SYS-040/041), plus the live standings that
// refresh over SSE (UC-011 #4; /static/capture.js drives the refresh —
// the CSP forbids inline scripts).
templ capturePage(p PageData, v captureView) {
	@layout(p) {
		<p class="capture-context">{ v.MeetName }</p>
		<h1 class="capture-title">{ v.Discipline }</h1>
		<p>
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture") }>{ p.T("capture.back_to_units") }</a>
			{ " · " }
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/sheet.pdf") }>{ p.T("pdf.download") }</a>
		</p>
		@protestBanner(p, v.MeetID, v.UnitID, v.Protest, v.CanOffice)
		if !v.IsField && v.CanOffice && !v.Protest.Announced && v.HasUnresulted {
			@bulkDNSAction(p, v.MeetID, v.UnitID)
		}
		if len(v.Rows) == 0 {
			<p>{ p.T("capture.no_participants") }</p>
		} else if v.IsField {
			@offlineCaptureControls(p, v)
			@fieldGrid(p, v)
		} else {
			@trackForm(p, v)
		}
		<section
			id="capture-standings"
			data-sse-topic={ "meet-" + v.MeetID }
			data-sse-event="results"
			data-sse-refresh={ "/meets/" + v.MeetID + "/capture/" + v.UnitID + "/standings" }
		>
			@captureStandings(p, v)
		</section>
		<script src="/static/capture.js"></script>
		if v.IsField {
			<script src="/static/capture-markers.js"></script>
			<script src="/static/capture-offline.js"></script>
		}
	}
}

// protestBanner renders a unit's SYS-047 protest-clock state (UC-015
// #1/#4): not-yet-announced units offer the office an "announce" action;
// announced units show provisional (with the countdown) or official. Shared
// by the track/horizontal capture page and the vertical-jump page
// (verticaljump.templ) — plain parameters rather than captureView so
// neither family-specific view type has to stand in for the other
// (TASK-040/DEC-024 gave vertical the same protest banner track/horizontal
// already had).
templ protestBanner(p PageData, meetID, unitID string, protest protestView, canOffice bool) {
	if protest.Announced {
		<p class="protest-banner" role="status">
			if protest.Official {
				{ p.T("capture.protest.official") }
			} else {
				{ p.T("capture.protest.provisional", "n", protest.RemainingMin) }
			}
		</p>
	} else if canOffice {
		<form
			action={ templ.URL("/meets/" + meetID + "/capture/" + unitID + "/announce") }
			method="post"
		>
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<button type="submit">{ p.T("capture.protest.announce") }</button>
		</form>
	}
}

// bulkDNSAction renders the TASK-041 bulk "mark remaining as DNS" link
// (DEC-025, OQ-070, SYS-114/SYS-046): the second real SYS-114 bulk
// operation, after check-in's close-check-in — a GET navigation to the
// TASK-034 confirm sub-page (confirm.go/confirm.templ), matching the
// "<a class=button>" pattern the other confirm-fronted destructive/bulk
// actions use (meet archive, account disable, athlete erasure), not a bare
// POST button.
templ bulkDNSAction(p PageData, meetID, unitID string) {
	<p>
		<a href={ templ.URL("/meets/" + meetID + "/capture/" + unitID + "/bulk-dns/confirm") } class="button">{ p.T("capture.bulk_dns.action") }</a>
	</p>
}

// offlineCaptureControls renders the offline-capture island's status
// indicator plus its configuration/i18n block (UC-034; SYS-085/087), and the
// re-authentication banner a 401/403 mid-queue surfaces (SYS-149, UC-040
// #4) — hidden by default, toggled by the island, never a plain-form
// element itself so a stale queue is never lost to a failed submit. The
// island (/static/capture-offline.js) reads everything from the config
// element's data-* attributes — the CSP forbids inline scripts, so no
// English is hardcoded in TypeScript: all strings arrive translated here.
templ offlineCaptureControls(p PageData, v captureView) {
	<div
		id="capture-offline-status"
		class="offline-status"
		role="status"
		aria-live="polite"
	>{ p.T("capture.offline.online") }</div>
	<div id="capture-reauth-banner" class="offline-banner" role="alert" hidden>
		{ p.T("capture.offline.reauth") }
		{ " " }
		<a href="/login">{ p.T("capture.offline.reauth_link") }</a>
	</div>
	<div
		id="capture-offline-config"
		hidden
		data-sync-url={ "/meets/" + v.MeetID + "/capture/" + v.UnitID + "/sync" }
		data-checkout-url={ "/meets/" + v.MeetID + "/capture/" + v.UnitID + "/checkout" }
		data-unit-id={ v.UnitID }
		data-meet-id={ v.MeetID }
		data-csrf={ p.CSRFToken }
		data-sw-url="/capture-sw.js"
		data-sw-scope={ "/meets/" + v.MeetID + "/capture/" }
		data-i18n-online={ p.T("capture.offline.online") }
		data-i18n-offline={ p.T("capture.offline.offline") }
		data-i18n-syncing={ p.T("capture.offline.syncing") }
		data-i18n-pending={ p.T("capture.offline.pending", "n", "{n}") }
		data-i18n-reconcile={ p.T("capture.offline.reconcile") }
		data-i18n-error={ p.T("capture.offline.error") }
		data-i18n-discard={ p.T("capture.offline.discard") }
		data-i18n-cell-pending={ p.T("capture.cell.pending") }
		data-i18n-cell-confirmed={ p.T("capture.cell.confirmed") }
		data-i18n-reject-invalid-mark={ p.T("capture.offline.reject.invalid_mark") }
		data-i18n-reject-unknown-athlete={ p.T("capture.offline.reject.unknown_athlete") }
		data-i18n-reject-announced={ p.T("capture.offline.reject.announced") }
		data-i18n-reject-generic={ p.T("capture.offline.reject.generic") }
	></div>
}

// fieldGrid renders the horizontal-attempt grid: one input per trial that
// takes a mark in metres or the D5.2 symbols (X foul, – pass, r
// retirement), with per-attempt wind where relevant (SYS-042, UC-011). Once
// the unit is announced (UC-015 #2), the per-trial cell forms turn
// read-only — SaveFieldAttempt rejects them anyway (ErrCorrectionRequired,
// OQ-036) — and each row grows the settled-level correction form
// (mark/status/reason/escalation) TASK-040/DEC-024 added, matching the
// track form's CorrectionMode columns.
templ fieldGrid(p PageData, v captureView) {
	<p>{ p.T("capture.value_help") }</p>
	if v.Protest.CorrectionMode {
		<p class="capture-correction-notice">{ p.T("capture.correct.notice") }</p>
		// One correction form per athlete outside the table, mirroring
		// trackForm's shape: a `<form>` may not be a `<tr>`'s descendant, so
		// the row's correction inputs associate via the HTML form attribute.
		for _, row := range v.Rows {
			<form
				id={ "field-correct-" + row.AthleteID }
				action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/correct") }
				method="post"
			>
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<input type="hidden" name="athlete" value={ row.AthleteID }/>
			</form>
		}
	}
	<table class="capture-grid stack-table" role="table">
		<thead role="rowgroup">
			<tr role="row">
				<th role="columnheader">{ p.T("roster.bib") }</th>
				<th role="columnheader">{ p.T("roster.name") }</th>
				for i := 1; i <= v.Attempts; i++ {
					<th role="columnheader">{ p.T("capture.trial_abbr") + intToStr(int64(i)) }</th>
				}
				if v.Protest.CorrectionMode {
					<th role="columnheader">{ p.T("capture.correct.mark") }</th>
					<th role="columnheader">{ p.T("capture.status") }</th>
					<th role="columnheader">{ p.T("capture.dq_rule") }</th>
					<th role="columnheader">{ p.T("capture.correct.reason") }</th>
					<th role="columnheader">{ p.T("capture.correct.escalation") }</th>
					<th role="columnheader"></th>
				}
				<th role="columnheader">{ p.T("capture.result") }</th>
				<th role="columnheader">{ p.T("standings.points_abbr") }</th>
			</tr>
		</thead>
		<tbody role="rowgroup">
			for _, row := range v.Rows {
				<tr role="row">
					<td role="cell" data-label={ p.T("roster.bib") }>{ row.Bib }</td>
					<td role="cell" data-label={ p.T("roster.name") }>{ row.Name }</td>
					for _, cell := range row.Cells {
						<td role="cell" data-label={ p.T("capture.trial_abbr") + cell.Seq }>
							if v.Protest.CorrectionMode {
								{ cell.Display }
							} else {
								<form
									action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/attempt") }
									method="post"
									class="cell-form"
									data-athlete={ row.AthleteID }
									data-seq={ cell.Seq }
								>
									<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
									<input type="hidden" name="athlete" value={ row.AthleteID }/>
									<input type="hidden" name="seq" value={ cell.Seq }/>
									<input type="hidden" name="version" value={ cell.Version }/>
									<input
										type="text"
										name="value"
										value={ cell.Value }
										size="6"
										inputmode="decimal"
										enterkeyhint="done"
										aria-label={ p.T("capture.trial_abbr") + cell.Seq + " " + row.Name }
									/>
									<span class="marker-actions" role="group" aria-label={ p.T("capture.marker_group") }>
										@markerButton("X", p.T("capture.marker.foul"))
										@markerButton("–", p.T("capture.marker.pass"))
										@markerButton("r", p.T("capture.marker.retire"))
									</span>
									if v.WindRelevant {
										<input
											type="text"
											name="wind"
											value={ cell.Wind }
											size="4"
											inputmode="decimal"
											enterkeyhint="done"
											placeholder={ p.T("capture.wind") }
											aria-label={ p.T("capture.wind") + " " + row.Name }
										/>
									}
									<button type="submit">{ p.T("capture.save") }</button>
									<span class="cell-save-badge" aria-hidden="true"></span>
								</form>
							}
						</td>
					}
					if v.Protest.CorrectionMode {
						<td role="cell" data-label={ p.T("capture.correct.mark") }>
							<input
								type="text"
								name="time"
								size="6"
								value={ row.Time }
								form={ "field-correct-" + row.AthleteID }
								aria-label={ p.T("capture.correct.mark") + " " + row.Name }
							/>
						</td>
						<td role="cell" data-label={ p.T("capture.status") }>
							<select name="status" form={ "field-correct-" + row.AthleteID } aria-label={ p.T("capture.status") + " " + row.Name }>
								<option value="" selected?={ row.Status == "" }>{ p.T("capture.status.none_mark") }</option>
								for _, st := range v.FieldStatuses {
									<option value={ st } selected?={ st == row.Status }>{ st }</option>
								}
							</select>
						</td>
						<td role="cell" data-label={ p.T("capture.dq_rule") } class="dq-rule-cell"><input type="text" name="status_detail" size="8" placeholder="TR16.8" value={ row.StatusDetail } form={ "field-correct-" + row.AthleteID } aria-label={ p.T("capture.dq_rule") + " " + row.Name }/></td>
						<td role="cell" data-label={ p.T("capture.correct.reason") }>
							<input
								type="text"
								name="reason"
								size="14"
								value={ row.Reason }
								form={ "field-correct-" + row.AthleteID }
								aria-label={ p.T("capture.correct.reason") + " " + row.Name }
								if row.Errors.Has(rowFieldKey("reason", row.AthleteID)) {
									aria-invalid="true"
									aria-describedby={ fieldErrorID(rowFieldKey("reason", row.AthleteID)) }
								}
							/>
							@fieldError(rowFieldKey("reason", row.AthleteID), row.Errors)
						</td>
						<td role="cell" data-label={ p.T("capture.correct.escalation") }>
							<input
								type="text"
								name="escalation"
								size="12"
								value={ row.Escalation }
								form={ "field-correct-" + row.AthleteID }
								aria-label={ p.T("capture.correct.escalation") + " " + row.Name }
								if row.Errors.Has(rowFieldKey("escalation", row.AthleteID)) {
									aria-invalid="true"
									aria-describedby={ fieldErrorID(rowFieldKey("escalation", row.AthleteID)) }
								}
							/>
							@fieldError(rowFieldKey("escalation", row.AthleteID), row.Errors)
						</td>
						<td role="cell" data-label=""><button type="submit" form={ "field-correct-" + row.AthleteID }>{ p.T("capture.save") }</button></td>
					}
					<td role="cell" data-label={ p.T("capture.result") } data-role="result" data-athlete-row={ row.AthleteID }>{ row.Result }</td>
					<td role="cell" data-label={ p.T("standings.points_abbr") } data-role="points" data-athlete-row={ row.AthleteID }>{ row.Points }</td>
				</tr>
			}
		</tbody>
	</table>
}

// markerButton renders one D5.2 letter-marker quick-action button
// (SYS-147, UC-039 #3): the mark/value input declares inputmode="decimal"
// (a numeric-only virtual keyboard), so these buttons are the alternate,
// always-available path for the non-numeric markers (X foul, – pass, r
// retirement in the horizontal grid; o clear as well in the vertical grid,
// verticaljump.templ). Wired by /static/capture-markers.js — a small,
// family-agnostic script that sets the sibling value input and re-submits
// the enclosing form, so it works whether that submit is a plain POST
// (track/vertical) or intercepted by the offline-capture island (field
// horizontal). glyph is the visible D5.2 notation (matches what the grid
// displays once saved); label is the localized accessible name.
templ markerButton(glyph, label string) {
	<button type="button" class="marker-btn" data-marker={ glyph } aria-label={ label }>{ glyph }</button>
}

// trackForm renders manual/FAT time entry per athlete (UC-010 subset for
// the UKC 60 m): time + timing method, or a CR 25 status — a DQ demands
// its rule reference (SYS-045).
templ trackForm(p PageData, v captureView) {
	if v.WindRelevant {
		@windForm(p, v)
	}
	if v.Protest.CorrectionMode {
		<p class="capture-correction-notice">{ p.T("capture.correct.notice") }</p>
	}
	// One form element per athlete outside the table; the row's inputs
	// associate via the HTML form attribute (a form must not span table
	// cells as a descendant of <tr>).
	for _, row := range v.Rows {
		<form
			id={ "track-" + row.AthleteID }
			action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/" + v.TrackFormAction) }
			method="post"
		>
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<input type="hidden" name="athlete" value={ row.AthleteID }/>
		</form>
	}
	<table class="capture-grid stack-table" role="table">
		<thead role="rowgroup">
			<tr role="row">
				<th role="columnheader">{ p.T("roster.bib") }</th>
				<th role="columnheader">{ p.T("seeding.lane") }</th>
				<th role="columnheader">{ p.T("roster.name") }</th>
				<th role="columnheader">{ p.T("capture.time") }</th>
				<th role="columnheader">{ p.T("capture.timing") }</th>
				<th role="columnheader">{ p.T("capture.status") }</th>
				<th role="columnheader">{ p.T("capture.dq_rule") }</th>
				if v.Protest.CorrectionMode {
					<th role="columnheader">{ p.T("capture.correct.reason") }</th>
					<th role="columnheader">{ p.T("capture.correct.escalation") }</th>
				}
				<th role="columnheader"></th>
				<th role="columnheader">{ p.T("capture.result") }</th>
				<th role="columnheader">{ p.T("standings.points_abbr") }</th>
			</tr>
		</thead>
		<tbody role="rowgroup">
			for _, row := range v.Rows {
				<tr role="row">
					<td role="cell" data-label={ p.T("roster.bib") }>{ row.Bib }</td>
					<td role="cell" data-label={ p.T("seeding.lane") }>{ row.Lane }</td>
					<td role="cell" data-label={ p.T("roster.name") }>{ row.Name }</td>
					<td role="cell" data-label={ p.T("capture.time") }>
						<input
							type="text"
							name="time"
							size="7"
							value={ row.Time }
							form={ "track-" + row.AthleteID }
							inputmode="decimal"
							enterkeyhint="done"
							aria-label={ p.T("capture.time") + " " + row.Name }
						/>
					</td>
					<td role="cell" data-label={ p.T("capture.timing") }>
						<select name="timing" form={ "track-" + row.AthleteID } class="timing-select" aria-label={ p.T("capture.timing") + " " + row.Name }>
							for _, t := range v.TrackTimings {
								<option value={ t } selected?={ t == row.Timing }>{ p.T("capture.timing." + t) }</option>
							}
						</select>
					</td>
					<td role="cell" data-label={ p.T("capture.status") }>
						<select name="status" form={ "track-" + row.AthleteID } aria-label={ p.T("capture.status") + " " + row.Name }>
							<option value="" selected?={ row.Status == "" }>{ p.T("capture.status.none") }</option>
							for _, st := range v.TrackStatuses {
								<option value={ st } selected?={ st == row.Status }>{ st }</option>
							}
						</select>
					</td>
					<td role="cell" data-label={ p.T("capture.dq_rule") } class="dq-rule-cell"><input type="text" name="status_detail" size="8" placeholder="TR16.8" value={ row.StatusDetail } form={ "track-" + row.AthleteID } aria-label={ p.T("capture.dq_rule") + " " + row.Name }/></td>
					if v.Protest.CorrectionMode {
						<td role="cell" data-label={ p.T("capture.correct.reason") }>
							<input
								type="text"
								name="reason"
								size="14"
								value={ row.Reason }
								form={ "track-" + row.AthleteID }
								aria-label={ p.T("capture.correct.reason") + " " + row.Name }
								if row.Errors.Has(rowFieldKey("reason", row.AthleteID)) {
									aria-invalid="true"
									aria-describedby={ fieldErrorID(rowFieldKey("reason", row.AthleteID)) }
								}
							/>
							@fieldError(rowFieldKey("reason", row.AthleteID), row.Errors)
						</td>
						<td role="cell" data-label={ p.T("capture.correct.escalation") }>
							<input
								type="text"
								name="escalation"
								size="12"
								value={ row.Escalation }
								form={ "track-" + row.AthleteID }
								aria-label={ p.T("capture.correct.escalation") + " " + row.Name }
								if row.Errors.Has(rowFieldKey("escalation", row.AthleteID)) {
									aria-invalid="true"
									aria-describedby={ fieldErrorID(rowFieldKey("escalation", row.AthleteID)) }
								}
							/>
							@fieldError(rowFieldKey("escalation", row.AthleteID), row.Errors)
						</td>
					}
					<td role="cell" data-label=""><button type="submit" form={ "track-" + row.AthleteID }>{ p.T("capture.save") }</button></td>
					<td role="cell" data-label={ p.T("capture.result") }>{ row.Result }</td>
					<td role="cell" data-label={ p.T("standings.points_abbr") }>{ row.Points }</td>
				</tr>
			}
		</tbody>
	</table>
}

// windForm captures the unit's single per-race wind reading (SYS-040,
// UC-010 #4): one field, applied uniformly to every mark in the race, never
// per athlete.
templ windForm(p PageData, v captureView) {
	<form
		action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/wind") }
		method="post"
		class="capture-wind-form"
	>
		<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
		<label>
			{ p.T("capture.wind") }
			<input type="text" name="wind" size="4" value={ v.CurrentWind } inputmode="decimal" enterkeyhint="done" aria-label={ p.T("capture.wind") } aria-describedby="capture-wind-hint"/>
		</label>
		@helpIcon(p, "capture.wind")
		<p class="hint" id="capture-wind-hint">{ p.T("capture.hint.wind") }</p>
		<button type="submit">{ p.T("capture.wind.save") }</button>
	</form>
}

// captureStandings is the live-refreshing unit ranking (UC-011 #4): rank
// by best mark with the D5.6 tie-break for field events, by time for
// track; hand times stay marked (SYS-041). Record/best flags (SYS-049)
// render in their own column, each linking to the SYS-051 documentation
// checklist. When the unit's entrants span more than one category
// (SYS-052, UC-028), a re-ranked table per category follows the combined
// race result.
templ captureStandings(p PageData, v captureView) {
	<h2>{ p.T("capture.standings") }</h2>
	@standingsTable(p, v.MeetID, v.UnitID, v.Standings, p.T("capture.standings_empty"))
	if len(v.Continuation) > 0 {
		<h3>{ p.T("capture.continuation", "n", intToStr(int64(v.CutTo))) }</h3>
		<ol>
			for _, name := range v.Continuation {
				<li>{ name }</li>
			}
		</ol>
	}
	if len(v.CategorySplits) > 1 {
		<h3>{ p.T("capture.category_splits") }</h3>
		for _, split := range v.CategorySplits {
			<h4>{ split.CategoryCode }</h4>
			@standingsTable(p, v.MeetID, v.UnitID, split.Standings, p.T("capture.standings_empty"))
		}
	}
}

// standingsTable renders one rank/bib/name/result/points/flags table —
// shared by the combined-unit standings and every per-category split group
// so both stay visually and structurally identical (SYS-052).
templ standingsTable(p PageData, meetID, unitID string, rows []standingRowView2, emptyText string) {
	if len(rows) == 0 {
		<p>{ emptyText }</p>
	} else {
		// SYS-147 names "unit standings" among the operator surfaces that
		// must fit 360px without page-level horizontal scroll — this table
		// renders on the same page as the capture grid above it, so it gets
		// the same row-card treatment (UC-039 #1).
		<table class="stack-table" role="table">
			<thead role="rowgroup">
				<tr role="row">
					<th role="columnheader">{ p.T("standings.rank") }</th>
					<th role="columnheader">{ p.T("roster.bib") }</th>
					<th role="columnheader">{ p.T("roster.name") }</th>
					<th role="columnheader">{ p.T("capture.result") }</th>
					<th role="columnheader">{ p.T("standings.points_abbr") }</th>
					<th role="columnheader">{ p.T("capture.record_flags") }</th>
				</tr>
			</thead>
			<tbody role="rowgroup">
				for _, row := range rows {
					<tr role="row">
						<td role="cell" data-label={ p.T("standings.rank") }>{ row.Rank }</td>
						<td role="cell" data-label={ p.T("roster.bib") }>{ row.Bib }</td>
						<td role="cell" data-label={ p.T("roster.name") }>{ row.Name }</td>
						<td role="cell" data-label={ p.T("capture.result") }>
							{ row.Mark }
							if row.Status != "" {
								{ " " + row.Status }
							}
						</td>
						<td role="cell" data-label={ p.T("standings.points_abbr") }>{ row.Points }</td>
						<td role="cell" data-label={ p.T("capture.record_flags") }>
							if row.Flags != "" {
								<a href={ templ.URL("/meets/" + meetID + "/capture/" + unitID + "/record-checklist/" + row.AthleteID) }>
									{ row.Flags }
								</a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// recordChecklistPage renders the SYS-051 Rekordprotokoll checklist for one
// flagged result (UC-016 #4): the in-system data plus explicit gaps for
// manual completion.
templ recordChecklistPage(p PageData, v recordChecklistView) {
	@layout(p) {
		<h1>{ p.T("record_checklist.title") }</h1>
		<p><strong>{ v.Flags }</strong></p>
		<table>
			<tbody>
				for _, it := range v.Items {
					<tr>
						<th scope="row">{ it.Label }</th>
						<td>
							if it.Gap {
								<em>{ p.T("record_checklist.gap") }</em>
							} else {
								{ it.Value }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID) }>{ p.T("record_checklist.back") }</a>
		</p>
	}
}
