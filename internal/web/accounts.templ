package web

// accountsPage is the instance-admin account administration view
// (TASK-013, SYS-090/091, UC-022): the account list with per-row
// enable/disable and role-change forms, plus the create-account form.
templ accountsPage(p PageData, v accountsView) {
	@layout(p) {
		<h1>{ p.T("accounts.title") }</h1>
		if len(v.Rows) == 0 {
			<p>{ p.T("accounts.empty") }</p>
		} else {
			<div class="table-scroll" tabindex="0">
				<table>
					<thead>
						<tr>
							<th scope="col">{ p.T("accounts.field.username") }</th>
							<th scope="col">{ p.T("accounts.field.display_name") }</th>
							<th scope="col">{ p.T("accounts.field.role") }</th>
							<th scope="col">{ p.T("accounts.field.status") }</th>
							<th scope="col"></th>
						</tr>
					</thead>
					<tbody>
						for _, a := range v.Rows {
							<tr>
								<td>{ a.Username }</td>
								<td>{ a.DisplayName }</td>
								<td>
									<form action={ templ.URL("/admin/accounts/" + a.ID + "/role") } method="post" class="inline-form">
										<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
										<select name="role" onchange="this.form.submit()">
											for _, ro := range v.Roles {
												<option value={ ro.Value } selected?={ ro.Value == a.Role }>{ ro.Label }</option>
											}
										</select>
									</form>
								</td>
								<td>
									if a.Enabled {
										{ p.T("accounts.status.enabled") }
									} else {
										{ p.T("accounts.status.disabled") }
									}
								</td>
								<td>
									if a.Enabled {
										<form action={ templ.URL("/admin/accounts/" + a.ID + "/disable") } method="post" class="inline-form">
											<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
											<button type="submit">{ p.T("accounts.action.disable") }</button>
										</form>
									} else {
										<form action={ templ.URL("/admin/accounts/" + a.ID + "/enable") } method="post" class="inline-form">
											<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
											<button type="submit">{ p.T("accounts.action.enable") }</button>
										</form>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		<h2>{ p.T("accounts.new.title") }</h2>
		<form action="/admin/accounts" method="post">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<label>
				{ p.T("accounts.field.username") }
				<input type="text" name="username" autocomplete="username" required?={ true }/>
			</label>
			<label>
				{ p.T("accounts.field.display_name") }
				<input type="text" name="display_name" required?={ true }/>
			</label>
			<label>
				{ p.T("accounts.new.password") }
				<input type="password" name="password" autocomplete="new-password" required?={ true } minlength="8"/>
			</label>
			<label>
				{ p.T("accounts.field.role") }
				<select name="role">
					for _, ro := range v.Roles {
						<option value={ ro.Value }>{ ro.Label }</option>
					}
				</select>
			</label>
			<button type="submit">{ p.T("accounts.new.submit") }</button>
		</form>
		// One-action backup (TASK-014, SYS-084, UC-020 #3) shares the
		// instance-admin surface; a GET link is deliberate — the download
		// never mutates meet data (see handleBackupDownload).
		<section>
			<h2>{ p.T("admin.backup.title") }</h2>
			<p>{ p.T("admin.backup.description") }</p>
			<a href="/admin/backup" class="button">{ p.T("admin.backup.download") }</a>
		</section>
		// SYS-102 retention-purge manual trigger (TASK-023, UC-024 #3)
		// shares the instance-admin surface, alongside backup.
		<section>
			<h2>{ p.T("privacy.retention.title") }</h2>
			<a href="/admin/privacy" class="button">{ p.T("privacy.retention.title") }</a>
		</section>
	}
}
