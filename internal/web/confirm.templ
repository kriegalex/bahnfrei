package web

// confirmPage is the shared OQ-074 destructive-action confirmation
// sub-page (see confirm.go's package doc for the CSP rationale and the
// friction-level rationale). Every one of the four destructive actions
// (athlete erasure, account disable, meet archive, retention purge), plus
// TASK-053's account password reset, renders through this one template so
// the pattern stays visually and structurally identical across all of
// them. TASK-047/SYS-152/UC-041 #4: when the action has gone stale —
// nothing left for it to apply to — Inapplicable renders the explanation
// with no form or confirm button at all, so navigating a now-inapplicable
// confirm URL never presents a live control.
templ confirmPage(p PageData, v confirmView) {
	@layout(p) {
		<h1>{ v.Title }</h1>
		if v.Inapplicable {
			<p role="status">{ v.Description }</p>
			<p><a href={ templ.URL(v.CancelHref) }>{ p.T("confirm.back") }</a></p>
		} else {
			<p class="error" role="alert">{ v.Description }</p>
			<form action={ templ.URL(v.FormAction) } method="post">
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				for _, h := range v.Hidden {
					<input type="hidden" name={ h.Name } value={ h.Value }/>
				}
				if v.TypedConfirm != "" {
					<label>
						{ v.TypedConfirmLabel }
						<input
							type="text"
							name={ v.TypedConfirmField }
							autocomplete="off"
							required?={ true }
							if v.FieldErr != "" {
								aria-invalid="true"
								aria-describedby={ fieldErrorID(v.TypedConfirmField) }
							}
						/>
					</label>
					if v.FieldErr != "" {
						<p class="field-error" id={ fieldErrorID(v.TypedConfirmField) } role="alert">{ v.FieldErr }</p>
					}
				}
				if v.PasswordField != "" {
					<label>
						{ v.PasswordFieldLabel }
						<input
							type="password"
							name={ v.PasswordField }
							autocomplete="new-password"
							required?={ true }
							minlength="8"
							if v.PasswordFieldErr != "" {
								aria-invalid="true"
								aria-describedby={ fieldErrorID(v.PasswordField) }
							}
						/>
					</label>
					if v.PasswordFieldErr != "" {
						<p class="field-error" id={ fieldErrorID(v.PasswordField) } role="alert">{ v.PasswordFieldErr }</p>
					}
				}
				<button type="submit">{ v.ConfirmLabel }</button>
				<a href={ templ.URL(v.CancelHref) }>{ p.T("confirm.cancel") }</a>
			</form>
		}
	}
}
