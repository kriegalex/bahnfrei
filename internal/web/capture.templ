package web

// captureIndexPage lists a meet's capturable units for the field official
// (UC-011/UC-010: track and horizontal field events in the PoC slice).
templ captureIndexPage(p PageData, v captureIndexView) {
	@layout(p) {
		<h1>{ v.MeetName } — { p.T("capture.title") }</h1>
		<p>
			<a href={ templ.URL("/meets/" + v.MeetID) }>{ p.T("roster.back_to_meet") }</a>
			{ " · " }
			<a href={ templ.URL("/meets/" + v.MeetID + "/reconciliation") }>{ p.T("reconciliation.title") }</a>
		</p>
		if len(v.Units) == 0 {
			<p>{ p.T("capture.units_empty") }</p>
		} else {
			<ul>
				for _, u := range v.Units {
					<li>
						<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + u.UnitID) }>{ u.Discipline }</a>
						{ " (" + p.T("family."+u.Family) + ")" }
						{ " · " }
						<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + u.UnitID + "/sheet.pdf") }>{ p.T("pdf.download") }</a>
					</li>
				}
			</ul>
		}
	}
}

// capturePage is the per-unit capture surface (TASK-008): the
// horizontal-attempt grid for field events (SYS-042) or the manual/FAT
// time form for track events (SYS-040/041), plus the live standings that
// refresh over SSE (UC-011 #4; /static/capture.js drives the refresh —
// the CSP forbids inline scripts).
templ capturePage(p PageData, v captureView) {
	@layout(p) {
		<h1>{ v.MeetName } — { v.Discipline }</h1>
		<p>
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture") }>{ p.T("capture.back_to_units") }</a>
			{ " · " }
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/sheet.pdf") }>{ p.T("pdf.download") }</a>
		</p>
		@protestBanner(p, v)
		if len(v.Rows) == 0 {
			<p>{ p.T("capture.no_participants") }</p>
		} else if v.IsField {
			@offlineCaptureControls(p, v)
			@fieldGrid(p, v)
		} else {
			@trackForm(p, v)
		}
		<section
			id="capture-standings"
			data-sse-topic={ "meet-" + v.MeetID }
			data-sse-event="results"
			data-sse-refresh={ "/meets/" + v.MeetID + "/capture/" + v.UnitID + "/standings" }
		>
			@captureStandings(p, v)
		</section>
		<script src="/static/capture.js"></script>
		if v.IsField {
			<script src="/static/capture-offline.js"></script>
		}
	}
}

// protestBanner renders the unit's SYS-047 protest-clock state (UC-015
// #1/#4): not-yet-announced units offer the office an "announce" action;
// announced units show provisional (with the countdown) or official.
templ protestBanner(p PageData, v captureView) {
	if v.Protest.Announced {
		<p class="protest-banner" role="status">
			if v.Protest.Official {
				{ p.T("capture.protest.official") }
			} else {
				{ p.T("capture.protest.provisional", "n", v.Protest.RemainingMin) }
			}
		</p>
	} else if v.CanOffice {
		<form
			action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/announce") }
			method="post"
		>
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<button type="submit">{ p.T("capture.protest.announce") }</button>
		</form>
	}
}

// offlineCaptureControls renders the offline-capture island's status
// indicator plus its configuration/i18n block (UC-034; SYS-085/087). The
// island (/static/capture-offline.js) reads everything from the config
// element's data-* attributes — the CSP forbids inline scripts, so no
// English is hardcoded in TypeScript: all strings arrive translated here.
templ offlineCaptureControls(p PageData, v captureView) {
	<div
		id="capture-offline-status"
		class="offline-status"
		role="status"
		aria-live="polite"
	>{ p.T("capture.offline.online") }</div>
	<div
		id="capture-offline-config"
		hidden
		data-sync-url={ "/meets/" + v.MeetID + "/capture/" + v.UnitID + "/sync" }
		data-checkout-url={ "/meets/" + v.MeetID + "/capture/" + v.UnitID + "/checkout" }
		data-unit-id={ v.UnitID }
		data-meet-id={ v.MeetID }
		data-csrf={ p.CSRFToken }
		data-sw-url="/capture-sw.js"
		data-sw-scope={ "/meets/" + v.MeetID + "/capture/" }
		data-i18n-online={ p.T("capture.offline.online") }
		data-i18n-offline={ p.T("capture.offline.offline") }
		data-i18n-syncing={ p.T("capture.offline.syncing") }
		data-i18n-pending={ p.T("capture.offline.pending", "n", "{n}") }
		data-i18n-reconcile={ p.T("capture.offline.reconcile") }
	></div>
}

// fieldGrid renders the horizontal-attempt grid: one input per trial that
// takes a mark in metres or the D5.2 symbols (X foul, – pass, r
// retirement), with per-attempt wind where relevant (SYS-042, UC-011).
templ fieldGrid(p PageData, v captureView) {
	<p>{ p.T("capture.value_help") }</p>
	<table class="capture-grid">
		<thead>
			<tr>
				<th>{ p.T("roster.bib") }</th>
				<th>{ p.T("roster.name") }</th>
				for i := 1; i <= v.Attempts; i++ {
					<th>{ p.T("capture.trial_abbr") + intToStr(int64(i)) }</th>
				}
				<th>{ p.T("capture.result") }</th>
				<th>{ p.T("standings.points_abbr") }</th>
			</tr>
		</thead>
		<tbody>
			for _, row := range v.Rows {
				<tr>
					<td>{ row.Bib }</td>
					<td>{ row.Name }</td>
					for _, cell := range row.Cells {
						<td>
							<form
								action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/attempt") }
								method="post"
								class="cell-form"
								data-athlete={ row.AthleteID }
								data-seq={ cell.Seq }
							>
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<input type="hidden" name="athlete" value={ row.AthleteID }/>
								<input type="hidden" name="seq" value={ cell.Seq }/>
								<input type="hidden" name="version" value={ cell.Version }/>
								<input
									type="text"
									name="value"
									value={ cell.Value }
									size="6"
									aria-label={ p.T("capture.trial_abbr") + cell.Seq + " " + row.Name }
								/>
								if v.WindRelevant {
									<input
										type="text"
										name="wind"
										value={ cell.Wind }
										size="4"
										placeholder={ p.T("capture.wind") }
										aria-label={ p.T("capture.wind") + " " + row.Name }
									/>
								}
								<button type="submit">{ p.T("capture.save") }</button>
							</form>
						</td>
					}
					<td>{ row.Result }</td>
					<td>{ row.Points }</td>
				</tr>
			}
		</tbody>
	</table>
}

// trackForm renders manual/FAT time entry per athlete (UC-010 subset for
// the UKC 60 m): time + timing method, or a CR 25 status — a DQ demands
// its rule reference (SYS-045).
templ trackForm(p PageData, v captureView) {
	if v.WindRelevant {
		@windForm(p, v)
	}
	if v.Protest.CorrectionMode {
		<p class="capture-correction-notice">{ p.T("capture.correct.notice") }</p>
	}
	// One form element per athlete outside the table; the row's inputs
	// associate via the HTML form attribute (a form must not span table
	// cells as a descendant of <tr>).
	for _, row := range v.Rows {
		<form
			id={ "track-" + row.AthleteID }
			action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/" + v.TrackFormAction) }
			method="post"
		>
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<input type="hidden" name="athlete" value={ row.AthleteID }/>
		</form>
	}
	<table class="capture-grid">
		<thead>
			<tr>
				<th>{ p.T("roster.bib") }</th>
				<th>{ p.T("seeding.lane") }</th>
				<th>{ p.T("roster.name") }</th>
				<th>{ p.T("capture.time") }</th>
				<th>{ p.T("capture.timing") }</th>
				<th>{ p.T("capture.status") }</th>
				<th>{ p.T("capture.dq_rule") }</th>
				if v.Protest.CorrectionMode {
					<th>{ p.T("capture.correct.reason") }</th>
					<th>{ p.T("capture.correct.escalation") }</th>
				}
				<th></th>
				<th>{ p.T("capture.result") }</th>
				<th>{ p.T("standings.points_abbr") }</th>
			</tr>
		</thead>
		<tbody>
			for _, row := range v.Rows {
				<tr>
					<td>{ row.Bib }</td>
					<td>{ row.Lane }</td>
					<td>{ row.Name }</td>
					<td>
						<input type="text" name="time" size="7" form={ "track-" + row.AthleteID } aria-label={ p.T("capture.time") + " " + row.Name }/>
					</td>
					<td>
						<select name="timing" form={ "track-" + row.AthleteID } aria-label={ p.T("capture.timing") + " " + row.Name }>
							for _, t := range v.TrackTimings {
								<option value={ t }>{ p.T("capture.timing." + t) }</option>
							}
						</select>
					</td>
					<td>
						<select name="status" form={ "track-" + row.AthleteID } aria-label={ p.T("capture.status") + " " + row.Name }>
							<option value="">{ p.T("capture.status.none") }</option>
							for _, st := range v.TrackStatuses {
								<option value={ st }>{ st }</option>
							}
						</select>
					</td>
					<td><input type="text" name="status_detail" size="8" placeholder="TR16.8" form={ "track-" + row.AthleteID } aria-label={ p.T("capture.dq_rule") + " " + row.Name }/></td>
					if v.Protest.CorrectionMode {
						<td><input type="text" name="reason" size="14" form={ "track-" + row.AthleteID } aria-label={ p.T("capture.correct.reason") + " " + row.Name }/></td>
						<td><input type="text" name="escalation" size="12" form={ "track-" + row.AthleteID } aria-label={ p.T("capture.correct.escalation") + " " + row.Name }/></td>
					}
					<td><button type="submit" form={ "track-" + row.AthleteID }>{ p.T("capture.save") }</button></td>
					<td>{ row.Result }</td>
					<td>{ row.Points }</td>
				</tr>
			}
		</tbody>
	</table>
}

// windForm captures the unit's single per-race wind reading (SYS-040,
// UC-010 #4): one field, applied uniformly to every mark in the race, never
// per athlete.
templ windForm(p PageData, v captureView) {
	<form
		action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/wind") }
		method="post"
		class="capture-wind-form"
	>
		<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
		<label>
			{ p.T("capture.wind") }
			<input type="text" name="wind" size="4" value={ v.CurrentWind } aria-label={ p.T("capture.wind") } aria-describedby="capture-wind-hint"/>
		</label>
		@helpIcon(p, "capture.wind")
		<p class="hint" id="capture-wind-hint">{ p.T("capture.hint.wind") }</p>
		<button type="submit">{ p.T("capture.wind.save") }</button>
	</form>
}

// captureStandings is the live-refreshing unit ranking (UC-011 #4): rank
// by best mark with the D5.6 tie-break for field events, by time for
// track; hand times stay marked (SYS-041). Record/best flags (SYS-049)
// render in their own column, each linking to the SYS-051 documentation
// checklist. When the unit's entrants span more than one category
// (SYS-052, UC-028), a re-ranked table per category follows the combined
// race result.
templ captureStandings(p PageData, v captureView) {
	<h2>{ p.T("capture.standings") }</h2>
	@standingsTable(p, v.MeetID, v.UnitID, v.Standings, p.T("capture.standings_empty"))
	if len(v.Continuation) > 0 {
		<h3>{ p.T("capture.continuation", "n", intToStr(int64(v.CutTo))) }</h3>
		<ol>
			for _, name := range v.Continuation {
				<li>{ name }</li>
			}
		</ol>
	}
	if len(v.CategorySplits) > 1 {
		<h3>{ p.T("capture.category_splits") }</h3>
		for _, split := range v.CategorySplits {
			<h4>{ split.CategoryCode }</h4>
			@standingsTable(p, v.MeetID, v.UnitID, split.Standings, p.T("capture.standings_empty"))
		}
	}
}

// standingsTable renders one rank/bib/name/result/points/flags table —
// shared by the combined-unit standings and every per-category split group
// so both stay visually and structurally identical (SYS-052).
templ standingsTable(p PageData, meetID, unitID string, rows []standingRowView2, emptyText string) {
	if len(rows) == 0 {
		<p>{ emptyText }</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>{ p.T("standings.rank") }</th>
					<th>{ p.T("roster.bib") }</th>
					<th>{ p.T("roster.name") }</th>
					<th>{ p.T("capture.result") }</th>
					<th>{ p.T("standings.points_abbr") }</th>
					<th>{ p.T("capture.record_flags") }</th>
				</tr>
			</thead>
			<tbody>
				for _, row := range rows {
					<tr>
						<td>{ row.Rank }</td>
						<td>{ row.Bib }</td>
						<td>{ row.Name }</td>
						<td>
							{ row.Mark }
							if row.Status != "" {
								{ " " + row.Status }
							}
						</td>
						<td>{ row.Points }</td>
						<td>
							if row.Flags != "" {
								<a href={ templ.URL("/meets/" + meetID + "/capture/" + unitID + "/record-checklist/" + row.AthleteID) }>
									{ row.Flags }
								</a>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}

// recordChecklistPage renders the SYS-051 Rekordprotokoll checklist for one
// flagged result (UC-016 #4): the in-system data plus explicit gaps for
// manual completion.
templ recordChecklistPage(p PageData, v recordChecklistView) {
	@layout(p) {
		<h1>{ p.T("record_checklist.title") }</h1>
		<p><strong>{ v.Flags }</strong></p>
		<table>
			<tbody>
				for _, it := range v.Items {
					<tr>
						<th scope="row">{ it.Label }</th>
						<td>
							if it.Gap {
								<em>{ p.T("record_checklist.gap") }</em>
							} else {
								{ it.Value }
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID) }>{ p.T("record_checklist.back") }</a>
		</p>
	}
}
