package web

// layout is the base HTML shell every page renders inside: HTMX is loaded
// once (ADR-003: "server-rendered HTML, progressively enhanced with
// HTMX"), navigation carries the login/logout state and the DE/FR locale
// switcher (SYS-110), and #main is a polite ARIA live region so future
// HTMX-swapped live updates (SSE-driven, SYS-071) announce accessibly
// without stealing focus (SYS-112/UC-026 #3 — the shell wires the
// landmark; content that streams into it arrives with later tasks). The
// home link renders "Bahnfrei" (a proper noun, not localized) with the
// `.brand` wordmark treatment (DEC-036, TASK-056) — a typographic
// treatment in the self-hosted display face, not a designed logo.
templ layout(p PageData) {
	<!DOCTYPE html>
	<html lang={ string(p.Locale) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title } · { p.T("app.title") }</title>
			<link rel="icon" href="/static/favicon.ico"/>
			// htmx defaults to injecting a <style> tag for .htmx-indicator
			// opacity rules on load; the strict CSP here (default-src 'self',
			// no style-src exception) blocks that inline style and logs a
			// console error on every page (F11/TASK-050). No template uses
			// hx-indicator/.htmx-indicator, so disabling the feature via its
			// documented meta-config hook is a clean no-op for the UI rather
			// than loosening the CSP.
			<meta name="htmx-config" content='{"includeIndicatorStyles": false}'/>
			<script src="/static/htmx.min.js"></script>
			<link rel="stylesheet" href="/static/tokens.css"/>
			<link rel="stylesheet" href="/static/base.css"/>
		</head>
		<body>
			<a class="skip-link" href="#main">{ p.T("nav.home") }</a>
			<header>
				<nav aria-label={ p.T("nav.aria_label") }>
					<a href="/" class="brand">{ p.T("app.title") }</a>
					<div class="nav-links">
						if p.CanOrganize {
							<a href="/meets" class="nav-link" if p.NavCurrent("/meets") { aria-current="page" }>{ p.T("nav.meets") }</a>
						}
						if p.CanViewAudit {
							<a href="/audit" class="nav-link" if p.NavCurrent("/audit") { aria-current="page" }>{ p.T("nav.audit") }</a>
						}
						if p.CanManageAccounts {
							<a href="/admin" class="nav-link" if p.NavCurrent("/admin") { aria-current="page" }>{ p.T("nav.accounts") }</a>
						}
					</div>
					<div class="nav-actions">
						if p.LoggedIn {
							<span class="who">{ p.T("auth.logged_in_as", "name", p.Username) }</span>
							<form action="/logout" method="post" class="inline-form">
								<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
								<button type="submit" class="button">{ p.T("nav.logout") }</button>
							</form>
						} else {
							<a href="/login" class="nav-link" if p.NavCurrent("/login") { aria-current="page" }>{ p.T("nav.login") }</a>
						}
						<form action="/locale" method="get" class="inline-form locale-switch">
							<label>
								{ p.T("footer.locale_switch") }
								<select name="lang" onchange="this.form.submit()">
									for _, loc := range p.Locales {
										<option value={ string(loc) } selected?={ loc == p.Locale }>
											{ localeLabel(p, loc) }
										</option>
									}
								</select>
							</label>
							// The onchange auto-submit above is a convenience, not the only
							// way to act (WCAG 2.2 SC 3.2.2 "On Input", AA): a person using a
							// screen reader or with JS/onchange-triggered submits disabled
							// still has an explicit, predictable control to apply the choice.
							<button type="submit" class="button">{ p.T("footer.locale_apply") }</button>
						</form>
					</div>
				</nav>
			</header>
			if p.LoggedIn {
				// Office blip-tolerance banner (UC-034 #7; SYS-087): the
				// office-banner island unhides this on a connectivity drop and
				// re-hides it on reconnect. Rendered on authenticated operator
				// surfaces only; the CSP forbids inline scripts so the string
				// arrives translated here, not in the TypeScript.
				<div id="offline-banner" class="offline-banner" role="alert" hidden>
					{ p.T("offline.banner.degraded") }
				</div>
			}
			<main id="main" aria-live="polite">
				if p.FlashError != "" {
					<p class="error" role="alert">{ p.FlashError }</p>
				}
				{ children... }
			</main>
			if p.LoggedIn {
				<script src="/static/office-banner.js"></script>
			}
			// Contextual-help island (TASK-031, SYS-115): loaded on every
			// page — help icons appear on operator, entry and fixture
			// surfaces, and the script is inert when a page renders none.
			<script src="/static/help.js"></script>
		</body>
	</html>
}
