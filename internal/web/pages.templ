package web

// homePage is the placeholder landing page for the server shell (TASK-005);
// meet/domain content replaces its body in later tasks.
templ homePage(p PageData) {
	@layout(p) {
		<h1>{ p.T("home.welcome") }</h1>
		<p>{ p.T("home.placeholder") }</p>
	}
}

// loginPage renders the credential form (SYS-091). The username/password
// fields are plain (no client-side islands here — that escape hatch is for
// per-widget interactivity, ADR-003, not this shell).
templ loginPage(p PageData) {
	@layout(p) {
		<h1>{ p.T("auth.login.title") }</h1>
		<form action="/login" method="post">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<label>
				{ p.T("auth.login.username") }
				<input type="text" name="username" autocomplete="username" required?={ true }/>
			</label>
			<label>
				{ p.T("auth.login.password") }
				<input type="password" name="password" autocomplete="current-password" required?={ true }/>
			</label>
			<button type="submit">{ p.T("auth.login.submit") }</button>
		</form>
	}
}

// adminPage renders the instance-admin workspace: today, the one-action
// backup download (SYS-084, UC-020 #3). A GET link is deliberate here —
// the action is a read-only export from the operator's point of view (it
// takes a snapshot and streams it back; it never mutates meet data), so a
// plain link/button that triggers a normal browser download is the
// simplest one-action affordance. Full instance administration (account
// management UI) is TASK-013's job.
templ adminPage(p PageData) {
	@layout(p) {
		<h1>{ p.T("admin.title") }</h1>
		<section>
			<h2>{ p.T("admin.backup.title") }</h2>
			<p>{ p.T("admin.backup.description") }</p>
			<a href="/admin/backup" class="button">{ p.T("admin.backup.download") }</a>
		</section>
	}
}

// forbiddenPage renders a localized 403 (SYS-090 authorization failures).
templ forbiddenPage(p PageData) {
	@layout(p) {
		<h1>{ p.T("error.forbidden") }</h1>
	}
}

// notFoundPage renders a localized 404.
templ notFoundPage(p PageData) {
	@layout(p) {
		<h1>{ p.T("error.not_found") }</h1>
	}
}
