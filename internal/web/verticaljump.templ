package web

// verticalCapturePage is the vertical-jump capture surface (TASK-021,
// UC-012, SYS-043): the height-progression grid plus the countback
// standings that refresh over SSE, and the office's height-configuration
// form. The protest banner and settled-level correction UI (TASK-040/
// DEC-024) mirror the track/horizontal capture page's UC-015 flow — the
// announce action was already reachable via the shared "/announce" route
// even before this page showed it.
templ verticalCapturePage(p PageData, v verticalCaptureView) {
	@layout(p) {
		<p class="capture-context">{ v.MeetName }</p>
		<h1 class="capture-title">{ v.Discipline }</h1>
		<p>
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture") }>{ p.T("capture.back_to_units") }</a>
			{ " · " }
			<a href={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/sheet.pdf") }>{ p.T("pdf.download") }</a>
		</p>
		@protestBanner(p, v.MeetID, v.UnitID, v.Protest, v.CanOffice)
		if v.CanOffice {
			@verticalHeightsForm(p, v)
		}
		if len(v.Heights) == 0 {
			<p>{ p.T("capture.vertical.heights_not_configured") }</p>
		} else if len(v.Rows) == 0 {
			<p>{ p.T("capture.no_participants") }</p>
		} else {
			<p>{ p.T("capture.vertical.trial_help") }</p>
			if v.Protest.CorrectionMode {
				<p class="capture-correction-notice">{ p.T("capture.correct.notice") }</p>
			}
			@verticalGrid(p, v)
			<script src={ assetURL("/static/capture-markers.js") }></script>
		}
		<section
			id="capture-standings"
			data-sse-topic={ "meet-" + v.MeetID }
			data-sse-event="results"
			data-sse-refresh={ "/meets/" + v.MeetID + "/capture/" + v.UnitID + "/standings" }
		>
			@verticalCaptureStandings(p, v)
		</section>
	}
}

// verticalHeightsForm lets the office configure the bar-height progression
// the first time, or extend it (a jump-off height) once already set
// (SYS-043: "office-configurable").
templ verticalHeightsForm(p PageData, v verticalCaptureView) {
	<form
		action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/vertical-heights") }
		method="post"
	>
		<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
		<input type="hidden" name="version" value={ intToStr(int64(len(v.Heights))) }/>
		if len(v.Heights) == 0 {
			<label>
				{ p.T("capture.vertical.configure_heights") }
				<input type="text" name="heights" placeholder="1.60, 1.65, 1.70, ..." aria-label={ p.T("capture.vertical.configure_heights") } aria-describedby="vertical-heights-hint"/>
			</label>
			@helpIcon(p, "capture.vertical.heights")
			<p class="hint" id="vertical-heights-hint">{ p.T("capture.vertical.hint.heights") }</p>
			<button type="submit">{ p.T("capture.save") }</button>
		} else {
			for _, h := range v.Heights {
				<input type="hidden" name="heights" value={ h }/>
			}
			<label>
				{ p.T("capture.vertical.add_height") }
				<input type="text" name="add_height" value={ v.NextHeightHint } size="6" aria-label={ p.T("capture.vertical.add_height") } aria-describedby="vertical-add-height-hint"/>
			</label>
			@helpIcon(p, "capture.vertical.add_height")
			<p class="hint" id="vertical-add-height-hint">{ p.T("capture.vertical.hint.heights") }</p>
			<button type="submit">{ p.T("capture.save") }</button>
		}
	</form>
}

// verticalGrid renders the height-progression grid: one input per trial,
// taking the D5.2 symbols (o clear, x foul, – pass, r retirement). Once the
// unit is announced (UC-015 #2), the per-trial cell forms turn read-only —
// SaveVerticalTrial rejects them anyway (ErrCorrectionRequired) — and each
// row grows the settled-level correction form (height/status/reason/
// escalation) TASK-040/DEC-024 added, matching the track/horizontal
// correction columns.
templ verticalGrid(p PageData, v verticalCaptureView) {
	if v.Protest.CorrectionMode {
		// One correction form per athlete outside the table, mirroring
		// fieldGrid/trackForm's shape: a `<form>` may not be a `<tr>`'s
		// descendant, so the row's correction inputs associate via the HTML
		// form attribute.
		for _, row := range v.Rows {
			<form
				id={ "vertical-correct-" + row.AthleteID }
				action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/correct") }
				method="post"
			>
				<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
				<input type="hidden" name="athlete" value={ row.AthleteID }/>
			</form>
		}
	}
	// The height x trial matrix is inherently two-dimensional (SYS-147,
	// UC-039 #1): it does not linearize into a one-column row-card the way
	// the field-horizontal/track grids do without hiding most of the
	// in-progress state, so this grid keeps its native table layout and
	// instead pins the bib/name columns while the height columns scroll
	// within their own container — the PAGE itself never gains horizontal
	// scroll, only this inner region does (design-system.md §2 documents
	// the trade-off).
	<div class="table-scroll vertical-grid-sticky" tabindex="0">
	<table class="capture-grid">
		<thead>
			<tr>
				<th rowspan="2">{ p.T("roster.bib") }</th>
				<th rowspan="2">{ p.T("roster.name") }</th>
				for _, h := range v.Heights {
					<th colspan="3">{ h }</th>
				}
				if v.Protest.CorrectionMode {
					<th rowspan="2">{ p.T("capture.correct.mark") }</th>
					<th rowspan="2">{ p.T("capture.status") }</th>
					<th rowspan="2">{ p.T("capture.dq_rule") }</th>
					<th rowspan="2">{ p.T("capture.correct.reason") }</th>
					<th rowspan="2">{ p.T("capture.correct.escalation") }</th>
					<th rowspan="2"></th>
				}
				<th rowspan="2">{ p.T("capture.result") }</th>
				<th rowspan="2">{ p.T("standings.points_abbr") }</th>
			</tr>
			<tr>
				for range v.Heights {
					<th>{ p.T("capture.trial_abbr") + "1" }</th>
					<th>{ p.T("capture.trial_abbr") + "2" }</th>
					<th>{ p.T("capture.trial_abbr") + "3" }</th>
				}
			</tr>
		</thead>
		<tbody>
			for _, row := range v.Rows {
				<tr>
					<td>{ row.Bib }</td>
					<td>{ row.Name }</td>
					for hi, height := range row.Cells {
						for si, cell := range height {
							<td>
								if v.Protest.CorrectionMode {
									{ cell.Value }
								} else {
									<form
										action={ templ.URL("/meets/" + v.MeetID + "/capture/" + v.UnitID + "/vertical-trial") }
										method="post"
										class="cell-form"
									>
										<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
										<input type="hidden" name="athlete" value={ row.AthleteID }/>
										<input type="hidden" name="height" value={ intToStr(int64(hi)) }/>
										<input type="hidden" name="seq" value={ intToStr(int64(si + 1)) }/>
										<input type="hidden" name="version" value={ cell.Version }/>
										<input
											type="text"
											name="value"
											value={ cell.Value }
											size="2"
											inputmode="none"
											aria-label={ v.Heights[hi] + " " + p.T("capture.trial_abbr") + intToStr(int64(si+1)) + " " + row.Name }
										/>
										<span class="marker-actions" role="group" aria-label={ p.T("capture.marker_group") }>
											@markerButton("o", p.T("capture.marker.clear"))
											@markerButton("x", p.T("capture.marker.foul"))
											@markerButton("–", p.T("capture.marker.pass"))
											@markerButton("r", p.T("capture.marker.retire"))
										</span>
										<button type="submit">{ p.T("capture.save") }</button>
									</form>
								}
							</td>
						}
					}
					if v.Protest.CorrectionMode {
						<td>
							<input
								type="text"
								name="time"
								size="6"
								value={ row.Time }
								form={ "vertical-correct-" + row.AthleteID }
								aria-label={ p.T("capture.correct.mark") + " " + row.Name }
							/>
						</td>
						<td>
							<select name="status" form={ "vertical-correct-" + row.AthleteID } aria-label={ p.T("capture.status") + " " + row.Name }>
								<option value="" selected?={ row.Status == "" }>{ p.T("capture.status.none_mark") }</option>
								for _, st := range v.FieldStatuses {
									<option value={ st } selected?={ st == row.Status }>{ st }</option>
								}
							</select>
						</td>
						<td class="dq-rule-cell"><input type="text" name="status_detail" size="8" placeholder="TR16.8" value={ row.StatusDetail } form={ "vertical-correct-" + row.AthleteID } aria-label={ p.T("capture.dq_rule") + " " + row.Name }/></td>
						<td>
							<input
								type="text"
								name="reason"
								size="14"
								value={ row.Reason }
								form={ "vertical-correct-" + row.AthleteID }
								aria-label={ p.T("capture.correct.reason") + " " + row.Name }
								if row.Errors.Has(rowFieldKey("reason", row.AthleteID)) {
									aria-invalid="true"
									aria-describedby={ fieldErrorID(rowFieldKey("reason", row.AthleteID)) }
								}
							/>
							@fieldError(rowFieldKey("reason", row.AthleteID), row.Errors)
						</td>
						<td>
							<input
								type="text"
								name="escalation"
								size="12"
								value={ row.Escalation }
								form={ "vertical-correct-" + row.AthleteID }
								aria-label={ p.T("capture.correct.escalation") + " " + row.Name }
								if row.Errors.Has(rowFieldKey("escalation", row.AthleteID)) {
									aria-invalid="true"
									aria-describedby={ fieldErrorID(rowFieldKey("escalation", row.AthleteID)) }
								}
							/>
							@fieldError(rowFieldKey("escalation", row.AthleteID), row.Errors)
						</td>
						<td><button type="submit" form={ "vertical-correct-" + row.AthleteID }>{ p.T("capture.save") }</button></td>
					}
					<td>{ row.Result }</td>
					<td>{ row.Points }</td>
				</tr>
			}
		</tbody>
	</table>
	</div>
}

// verticalCaptureStandings renders the current SYS-043 countback ranking
// (UC-012 #3/#4): fewer attempts at the best height, then fewer total
// failures, with a persisting first-place tie flagged for the office.
templ verticalCaptureStandings(p PageData, v verticalCaptureView) {
	<h2>{ p.T("capture.standings") }</h2>
	if v.StandingsEmpty {
		<p>{ p.T("capture.standings_empty") }</p>
	} else {
		// SYS-147 names "unit standings" among the operator surfaces that
		// must fit 360px without page-level horizontal scroll (UC-039 #1).
		<table class="stack-table" role="table">
			<thead role="rowgroup">
				<tr role="row">
					<th role="columnheader">{ p.T("standings.rank") }</th>
					<th role="columnheader">{ p.T("roster.bib") }</th>
					<th role="columnheader">{ p.T("roster.name") }</th>
					<th role="columnheader">{ p.T("capture.vertical.best") }</th>
					<th role="columnheader">{ p.T("capture.vertical.attempts_at_best") }</th>
					<th role="columnheader">{ p.T("capture.vertical.total_failures") }</th>
					<th role="columnheader">{ p.T("standings.points_abbr") }</th>
					<th role="columnheader"></th>
				</tr>
			</thead>
			<tbody role="rowgroup">
				for _, row := range v.Standings {
					<tr role="row">
						<td role="cell" data-label={ p.T("standings.rank") }>{ row.Rank }</td>
						<td role="cell" data-label={ p.T("roster.bib") }>{ row.Bib }</td>
						<td role="cell" data-label={ p.T("roster.name") }>{ row.Name }</td>
						<td role="cell" data-label={ p.T("capture.vertical.best") }>{ row.BestHeight }</td>
						<td role="cell" data-label={ p.T("capture.vertical.attempts_at_best") }>{ row.AttemptsAtBest }</td>
						<td role="cell" data-label={ p.T("capture.vertical.total_failures") }>{ row.TotalFailures }</td>
						<td role="cell" data-label={ p.T("standings.points_abbr") }>{ row.Points }</td>
						<td role="cell" data-label="">{ row.Flags }</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
