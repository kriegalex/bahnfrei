package web

// officialsPage is the office's field-official assignment matrix for one
// meet (TASK-013, SYS-090 "assignable per meet"; UC-022 #1): a grid of
// field-official accounts × capturable units, each cell a one-click
// assign/unassign toggle.
templ officialsPage(p PageData, v officialsView) {
	@layout(p) {
		<h1>{ v.MeetName } — { p.T("officials.title") }</h1>
		<p>{ p.T("officials.hint") }</p>
		if len(v.Rows) == 0 {
			<p>{ p.T("officials.no_officials") }</p>
		} else if len(v.Columns) == 0 {
			<p>{ p.T("capture.units_empty") }</p>
		} else {
			<div class="table-scroll" tabindex="0">
				<table>
					<thead>
						<tr>
							<th scope="col"></th>
							for _, col := range v.Columns {
								<th scope="col">{ col.Label }</th>
							}
						</tr>
					</thead>
					<tbody>
						for _, row := range v.Rows {
							<tr>
								<td>{ row.Label }</td>
								for i, col := range v.Columns {
									<td>
										if row.Assigned[i] {
											<form action={ templ.URL("/meets/" + v.MeetID + "/officials/unassign") } method="post" class="inline-form">
												<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
												<input type="hidden" name="account_id" value={ row.AccountID }/>
												<input type="hidden" name="unit_id" value={ col.UnitID }/>
												<button type="submit">{ p.T("officials.assigned") } — { p.T("officials.action.unassign") }</button>
											</form>
										} else {
											<form action={ templ.URL("/meets/" + v.MeetID + "/officials/assign") } method="post" class="inline-form">
												<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
												<input type="hidden" name="account_id" value={ row.AccountID }/>
												<input type="hidden" name="unit_id" value={ col.UnitID }/>
												<button type="submit">{ p.T("officials.action.assign") }</button>
											</form>
										}
									</td>
								}
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
