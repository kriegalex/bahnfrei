package web

// changePasswordPage is the TASK-053/DEC-030 forced change-password step:
// reached after an admin-issued temporary password, and via
// forcePasswordChangeGate (middleware.go) every other authenticated route
// until it is completed. Field-level errors (OQ-075/UC-038 #4 convention)
// attribute each failure to the field that caused it.
templ changePasswordPage(p PageData, v changePasswordView) {
	@layout(p) {
		<h1>{ p.T("change_password.title") }</h1>
		<p>{ p.T("change_password.intro") }</p>
		<form action="/change-password" method="post">
			<input type="hidden" name="csrf_token" value={ p.CSRFToken }/>
			<label>
				{ p.T("change_password.current_password") }
				<input
					type="password"
					name="current_password"
					autocomplete="current-password"
					required?={ true }
					if v.Errors.Has("current_password") {
						aria-invalid="true"
						aria-describedby={ fieldErrorID("current_password") }
					}
				/>
			</label>
			@fieldError("current_password", v.Errors)
			<label>
				{ p.T("change_password.new_password") }
				<input
					type="password"
					name="new_password"
					autocomplete="new-password"
					required?={ true }
					minlength="8"
					if v.Errors.Has("new_password") {
						aria-invalid="true"
						aria-describedby={ "change-password-hint " + fieldErrorID("new_password") }
					} else {
						aria-describedby="change-password-hint"
					}
				/>
			</label>
			<p class="hint" id="change-password-hint">{ p.T("change_password.hint.password") }</p>
			@fieldError("new_password", v.Errors)
			<label>
				{ p.T("change_password.confirm_password") }
				<input
					type="password"
					name="confirm_password"
					autocomplete="new-password"
					required?={ true }
					if v.Errors.Has("confirm_password") {
						aria-invalid="true"
						aria-describedby={ fieldErrorID("confirm_password") }
					}
				/>
			</label>
			@fieldError("confirm_password", v.Errors)
			<button type="submit">{ p.T("change_password.submit") }</button>
		</form>
	}
}
